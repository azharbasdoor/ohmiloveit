<script>
  const TIME_KEY = 'music-time';

  async function startMusic() {
    const audio = document.getElementById('bg-music') as HTMLAudioElement | null;
    if (!audio) return;

    // Pulihkan posisi waktu (hanya sekali per sesi elemen)
    if (!audio.dataset.timeRestored) {
      const savedTime = sessionStorage.getItem(TIME_KEY);
      if (savedTime) {
        audio.currentTime = parseFloat(savedTime) || 0;
      }
      audio.dataset.timeRestored = 'true';
    }

    // Kalau sudah main, tidak perlu apa-apa
    if (!audio.paused) return;

    // Tunggu audio siap diputar (readyState >= 2 = HAVE_CURRENT_DATA)
    async function waitReady(): Promise<void> {
      if (audio.readyState >= 2) return;
      await new Promise<void>((resolve) => {
        const done = () => {
          audio.removeEventListener('loadedmetadata', done);
          resolve();
        };
        audio.addEventListener('loadedmetadata', done, { once: true });
        // Jangan tunggu selamanya
        setTimeout(done, 3000);
      });
    }

    async function attemptPlay(): Promise<boolean> {
      try {
        await waitReady();
        await audio.play();
        return true;
      } catch {
        return false;
      }
    }

    // Percobaan pertama
    const ok = await attemptPlay();
    if (ok) return;

    // Gagal → pasang fallback interaksi (dan biarkan menempel sampai berhasil)
    if (audio.dataset.fallbackAttached === 'true') return;
    audio.dataset.fallbackAttached = 'true';

    const onGesture = () => {
      audio.play()
        .then(() => {
          // Berhasil → lepaskan semua listener
          document.removeEventListener('click', onGesture);
          document.removeEventListener('touchstart', onGesture);
          document.removeEventListener('scroll', onGesture);
          document.removeEventListener('keydown', onGesture);
          audio.dataset.fallbackAttached = 'false';
        })
        .catch(() => { /* biarkan, akan dicoba lagi di gesture berikutnya */ });
    };

    document.addEventListener('click', onGesture, { passive: true });
    document.addEventListener('touchstart', onGesture, { passive: true });
    document.addEventListener('scroll', onGesture, { passive: true });
    document.addEventListener('keydown', onGesture, { passive: true });
  }

  document.addEventListener('astro:page-load', startMusic);
</script>
