---
// Komponen audio global. Element ada di semua halaman, tapi musik
// hanya diputar saat path = /blog atau /blog/*. Strategi:
// - Saat klik link internal: putar/pause audio berdasarkan tujuan (gesture masih valid)
// - Saat astro:page-load: sinkronkan state dengan path saat ini
// - Kalau autoplay diblokir: tunggu gesture pertama user
---

<audio
  id="bg-music"
  src="/music/ambient.mp3"
  loop
  preload="auto"
  transition:persist="bg-music"
></audio>

<script>
  const TIME_KEY = 'music-time';
  const BLOG_RE = /^\/blog(\/|$)/;

  function isBlogPath(path: string): boolean {
    return BLOG_RE.test(path);
  }

  function getAudio(): HTMLAudioElement | null {
    return document.getElementById('bg-music') as HTMLAudioElement | null;
  }

  function restoreTime(audio: HTMLAudioElement) {
    if (audio.dataset.timeRestored === 'true') return;
    const saved = sessionStorage.getItem(TIME_KEY);
    if (saved) audio.currentTime = parseFloat(saved) || 0;
    audio.dataset.timeRestored = 'true';
  }

  function saveTime(audio: HTMLAudioElement) {
    sessionStorage.setItem(TIME_KEY, String(audio.currentTime));
  }

  async function ensurePlaying() {
    const audio = getAudio();
    if (!audio) return;
    if (!isBlogPath(location.pathname)) return;
    if (!audio.paused) return;

    restoreTime(audio);

    // Tunggu audio siap (readyState >= 2 = HAVE_CURRENT_DATA)
    if (audio.readyState < 2) {
      await new Promise<void>((resolve) => {
        const done = () => {
          audio.removeEventListener('loadedmetadata', done);
          resolve();
        };
        audio.addEventListener('loadedmetadata', done, { once: true });
        setTimeout(done, 3000);
      });
    }

    try {
      await audio.play();
    } catch {
      attachFirstGestureFallback();
    }
  }

  function pauseIfNotBlog() {
    const audio = getAudio();
    if (!audio || audio.paused) return;
    if (isBlogPath(location.pathname)) return;
    audio.pause();
    saveTime(audio);
  }

  let fallbackAttached = false;
  function attachFirstGestureFallback() {
    if (fallbackAttached) return;
    fallbackAttached = true;

    const handler = () => {
      fallbackAttached = false;
      document.removeEventListener('click', handler, true);
      document.removeEventListener('touchstart', handler, true);
      document.removeEventListener('scroll', handler, true);
      document.removeEventListener('keydown', handler, true);
      ensurePlaying();
    };

    document.addEventListener('click', handler, true);
    document.addEventListener('touchstart', handler, true);
    document.addEventListener('scroll', handler, true);
    document.addEventListener('keydown', handler, true);
  }

  // KUNCI: intercept klik link internal — putar/pause SEKARANG, saat gesture masih valid
  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const link = target?.closest('a');
    if (!link) return;

    const href = link.getAttribute('href');
    if (!href || !href.startsWith('/')) return; // hanya link internal

    const audio = getAudio();
    if (!audio) return;

    if (isBlogPath(href)) {
      // Tujuan blog → putar sekarang
      restoreTime(audio);
      audio.play().catch(() => {});
    } else {
      // Tujuan non-blog → hentikan sekarang
      if (!audio.paused) {
        audio.pause();
        saveTime(audio);
      }
    }
  }, { capture: true, passive: true });

  // Setiap kali halaman selesai dimuat (termasuk navigasi SPA)
  document.addEventListener('astro:page-load', () => {
    if (isBlogPath(location.pathname)) {
      ensurePlaying();
    } else {
      pauseIfNotBlog();
    }
  });

  // Simpan posisi berkala
  setInterval(() => {
    const audio = getAudio();
    if (audio && !audio.paused) saveTime(audio);
  }, 1000);

  window.addEventListener('beforeunload', () => {
    const audio = getAudio();
    if (audio) saveTime(audio);
  });
</script>
