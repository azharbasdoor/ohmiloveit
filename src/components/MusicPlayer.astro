---
// Komponen musik latar untuk seksi blog.
// Strategi: coba play() langsung; jika diblokir browser, tunggu interaksi pertama user.
---

<audio
  id="bg-music"
  src="/music/ambient.mp3"
  loop
  preload="auto"
  transition:persist="bg-music"
></audio>

<script>
  const TIME_KEY = 'music-time';

  function startMusic() {
    const audio = document.getElementById('bg-music') as HTMLAudioElement | null;
    if (!audio) return;

    // Guard: jangan init dua kali saat navigasi SPA
    if (audio.dataset.initialized === 'true') {
      if (audio.paused) {
        audio.play().catch(() => {});
      }
      return;
    }
    audio.dataset.initialized = 'true';

    // Pulihkan posisi waktu terakhir
    const savedTime = sessionStorage.getItem(TIME_KEY);
    if (savedTime) {
      audio.currentTime = parseFloat(savedTime) || 0;
    }

    // Coba play langsung
    audio.play().catch(() => {
      // Gagal → pasang listener sekali pakai untuk interaksi pertama
      const tryPlay = () => {
        audio.play().catch(() => {});
        cleanup();
      };
      const cleanup = () => {
        document.removeEventListener('click', tryPlay);
        document.removeEventListener('touchstart', tryPlay);
        document.removeEventListener('keydown', tryPlay);
        document.removeEventListener('scroll', tryPlay);
      };

      document.addEventListener('click', tryPlay, { once: true, passive: true });
      document.addEventListener('touchstart', tryPlay, { once: true, passive: true });
      document.addEventListener('keydown', tryPlay, { once: true, passive: true });
      document.addEventListener('scroll', tryPlay, { once: true, passive: true });
    });

    // Simpan posisi waktu berkala
    setInterval(() => {
      if (!audio.paused) {
        sessionStorage.setItem(TIME_KEY, String(audio.currentTime));
      }
    }, 1000);

    window.addEventListener('beforeunload', () => {
      sessionStorage.setItem(TIME_KEY, String(audio.currentTime));
    });
  }

  document.addEventListener('astro:page-load', startMusic);
</script>
